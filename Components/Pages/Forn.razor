@using AppPapelaria1.Model
@using AppPapelaria1.Config
@inject FornecedorDAO fornecedorDao
@inject CategoriaDAO categoriaDao

            <h2>Fornecedor</h2>

            <div class="grupo-input">
                <label>Id do Fornecedor</label>
                <input type="text"
                       placeholder="ex: 1" />
            </div>

            <div class="grupo-input">
                <label>Nome do Fornecedor</label>
                <input type="text"
                       placeholder="ex: ABC Papelaria" />
            </div>

            <div class="grupo-input">
                <label>Telefone</label>
                <input type="text"
                       placeholder="(00) 00000-0000" />
            </div>

            
                <div class="grupo-input">
                <!-- Rótulo do campo para o usuário saber o que deve selecionar -->
                <label>Categoria</label>

                <!-- Caixinha de seleção (Dropdown) -->
                <select>
                    <!-- Opção padrão que fica selecionada e desabilitada antes do usuário escolher -->
                    <option selected disabled value="">
                        Selecione uma categoria
                    </option>

                    <!-- Verifica se a lista de categorias não está nula -->
                    @if (categorias != null)
                    {
                        <!-- Laço de repetição: Passa por CADA categoria vinda do banco de dados -->
                        @foreach (var c in categorias)
                        {
                            <option value="@c.Id">@c.Nome</option>
                        }
                    }
                </select>
            </div>
            
            

        

@code {
    private List<Fornecedor> fornecedores = new();
    private List<AppPapelaria1.Model.Categoria> categorias = new();

    protected override void OnInitialized()
    {
        // Substitui o uso de FornecedorP.Listar()
        fornecedores = fornecedorDao.Listar();

        // Substitui a instanciação manual passando o tipo Conexao
        categorias = categoriaDao.Listar();
    }
}