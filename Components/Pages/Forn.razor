@page "/fornecedor"
@inject FornecedorDAO FornecedorP
@inject AppPapelaria1.Config.Conexao Conexao
@using AppPapelaria1.Model;
@using AppPapelaria1.DAO;

<div class="container">

    <div class="conteudo">

        <div class="card">
            @* id_for int auto_increment primary key,
            nome_fantasia_for varchar(150) not null,
            telefone_for varchar(30),
            endereco_for varchar (100),
            cnpj_for varchar(20),
            email_for varchar (100) *@

            <h2>Fornecedor</h2>

            <div class="grupo-input">
                <label>Id do Fornecedor</label>
                <input type="text"
                       placeholder="ex: 1" />
            </div>

            <div class="grupo-input">
                <label>Nome do Fornecedor</label>
                <input type="text"
                       placeholder="ex: ABC Papelaria" />
            </div>

            <div class="grupo-input">
                <label>Telefone</label>
                <input type="text"
                       placeholder="(00) 00000-0000" />
            </div>

            
                <div class="grupo-input">
                <!-- Rótulo do campo para o usuário saber o que deve selecionar -->
                <label>Categoria</label>

                <!-- Caixinha de seleção (Dropdown) -->
                <select>
                    <!-- Opção padrão que fica selecionada e desabilitada antes do usuário escolher -->
                    <option selected disabled value="">
                        Selecione uma categoria
                    </option>

                    <!-- Verifica se a lista de categorias não está nula -->
                    @if (categorias != null)
                    {
                        <!-- Laço de repetição: Passa por CADA categoria vinda do banco de dados -->
                        @foreach (var c in categorias)
                        {
                            <option value="@c.Id">@c.Nome</option>
                        }
                    }
                </select>
            </div>
            

        </div>

    </div>

</div>

@code {
    // Declarando as variáveis da lista para o Blazor reconhecer no HTML
    private List<Fornecedor> fornecedores { get; set; } = new();
    
    // Força o tipo correto usando o caminho completo da pasta Model:
    private List<AppPapelaria1.Model.Categoria> categorias { get; set; } = new();


    protected override Task OnInitializedAsync()
    {
        // Busca os fornecedores
        fornecedores = FornecedorP.Listar();

        // Instancia o CategoriaDAO com a conexão injetada e busca as categorias
        @*var categoriaDAO = new CategoriaDAO(Conexao);
        categorias = categoriaDAO.Listar();*@

        return Task.CompletedTask;
    }
}