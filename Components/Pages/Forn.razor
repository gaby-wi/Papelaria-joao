@page "/fornecedor"
@inject FornecedorDAO FornecedorP
<div class="container">

    <div class="topo">
        <h1>📦 Fornecedor de Materiais</h1>
        <p>Sistema de gerenciamento da papelaria</p>
    </div>

    <div class="conteudo">

        <!-- FORMULÁRIO -->
        <!-- Cadastro de fornecedores -->
        <div class="card">
            @* CREATE TABLE fornecedor (
            id_for INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
            nome_for VARCHAR(200),
            cnpj_for VARCHAR(200),
            telefone_for VARCHAR(200),
            categoria_for VARCHAR(200),
            observacoes_for VARCHAR(200) *@

            <h2>Cadastro de Fornecedor</h2>

            <div class="grupo-input">
                <label>Nome da Empresa</label>

                <input type="text"
                       placeholder="Digite o nome da empresa" />
            </div>

            <div class="grupo-input">
                <label>CNPJ</label>

                <input type="text"
                       placeholder="00.000.000/0000-00" />
            </div>

            <div class="grupo-input">
                <label>Telefone</label>

                <input type="text"
                       placeholder="(00) 00000-0000" />
            </div>

            <div class="grupo-input">
                <label>Categoria</label>

                <select>

                    <option selected disabled>
                        Selecione uma categoria
                    </option>

                    <option>Papelaria</option>
                    <option>Informática</option>
                    <option>Escritório</option>
                    <option>Artes</option>

                </select>
            </div>

            <!-- Informações do fornecedor -->
            <div class="grupo-input">
                <label>Observações</label>

                <textarea placeholder="Digite observações sobre o fornecedor">
                </textarea>
            </div>

            <div class="botoes">

                <button class="btn-salvar">
                    Salvar
                </button>

                <button class="btn-limpar">
                    Limpar
                </button>

            </div>

        </div>

        <!-- TABELA -->
        <div class="card">

            <h2>Fornecedores Cadastrados</h2>

            <table>

                <thead>
                    <tr>
                        <th>Empresa</th>
                        <th>Categoria</th>
                        <th>Status</th>
                    </tr>
                </thead>
                @foreach(var forn in fornecedores)
                {
                    <tr>
                        <td>@forn.Nome</td>
                        <td>@forn.Categoria</td>
                        <td>@forn.Observacoes</td>
                    </tr>
                }
            </table>

        </div>

    </div>

</div>
@code {
    private List<AppPapelaria1.Model.Fornecedor> fornecedores { get; set; } = [];
    private string? MensagemErro { get; set; }

    protected override Task OnInitializedAsync()
    {
        fornecedores = FornecedorP.Listar();

        return Task.CompletedTask;
    }   
}