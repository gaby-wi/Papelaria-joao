
@page "/fornecedor"
@rendermode InteractiveServer
@inject FornecedorDAO dao;

<PageTitle>Fornecedor - Sistemas de Controle de Fornecedores</PageTitle>


<div class="d-flex justify-content-between align-items-cent
    er mb-4">
    <div>
        <h2 class="fw-bold mb-1">Consulta de Processos</h2>
    </div>
    <div>
        <a href="/fornecedor/cadastro" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Novo Fornecedor
        </a>
    </div>
</div>
<div class="custom-table-card">
    <div class=" table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    
                    <th>Id</th>
                    <th>Nome</th>
                    <th>Cnpj</th>
                    <th>Telefone</th>
                    <th>Email</th>
                    <th>Endereco</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in fornecedor)
                {
                    <tr>
                        <td>@f.Id</td>
                        <td>@f.Nome</td>
                        <td>@f.Cnpj</td>
                        <td>@f.Telefone</td>
                        <td>@f.Email</td>
                        <td>@f.Endereco</td>
                        @* <td class="text-truncate">@f.Telefone</td>
                        <td>
                            <i class="bi bi-clock"></i>@f.Email
                        </td> *@
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a href="#" class="btn btn-light border text-primary" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="#" class="btn btn-light border text-danger" title="Excluir">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }

            
                
            </tbody>
        </table>
    </div>
</div>



@code {

    private List<Fornecedor> fornecedor = new();


    protected override void OnInitialized()
    {
        CarregarFornecedor();
    }




    private void CarregarFornecedor()
    {
        fornecedor = dao.Listar();
    }

}

