@page "/caixa"
@using AppPapelaria1.DAO
@inject CaixaDAO CaixaDAO

<PageTitle>Controle de Caixa</PageTitle>

<div class="container-fluid">

    <h1 class="h3 fw-bold text-gray-800 mb-4">
        Controle de Caixa
    </h1>

    <div class="row mb-4">
        <!-- Card Abertura -->
        <div class="col-md-4">
            <div class="card shadow p-3">
                <h5>Abertura do Caixa</h5>
                <label>Valor Inicial</label>
                <input class="form-control mb-3" type="number" />
                <button class="btn btn-primary">
                    Abrir Caixa
                </button>
            </div>
        </div>

        <!-- Card Entradas -->
        <div class="col-md-4">
            <div class="card shadow p-3">
                <h5>Entradas</h5>
                <h2 class="text-success">R$ 1.250,00</h2>
            </div>
        </div>

        <!-- Card Saídas -->
        <div class="col-md-4">
            <div class="card shadow p-3">
                <h5>Saídas</h5>
                <h2 class="text-danger">R$ 150,00</h2>
            </div>
        </div>
    </div>

    <!-- Tabela de Registros da Base de Dados -->
    <div class="card shadow p-3">
        <h5 class="mb-3">Registros de Caixas</h5>

        @if (caixas == null)
        {
            <p><em>A carregar dados do banco...</em></p>
        }
        else if (caixas.Count == 0)
        {
            <p class="text-muted">Nenhum registo de caixa encontrado.</p>
        }
        else
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Data Abertura</th>
                        <th>Data Fechamento</th>
                        <th>Valor Inicial</th>
                        <th>Valor Final</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in caixas)
                    {
                        <tr>
                            <td>@c.Id</td>
                            <td>@c.DataAbertura.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(c.DataFechamento.HasValue ? c.DataFechamento.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                            <td>R$ @c.ValorInicial.ToString("F2")</td>
                            <td>R$ @c.ValorFinal.ToString("F2")</td>
                            <td>
                                <span class="badge @(c.Status == "Aberto" ? "bg-success" : "bg-secondary")">
                                    @c.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

</div>

@code {
    // Uso explícito de AppPapelaria1.Model.Caixa para não conflitar com a página Caixa.razor
    private List<AppPapelaria1.Model.Caixa> caixas = new();

    protected override void OnInitialized()
    {
        caixas = CaixaDAO.Listar();
    }
}