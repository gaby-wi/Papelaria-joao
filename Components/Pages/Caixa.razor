@page "/caixa"
@inject AppPapelaria1.DAO.CaixaDAO CaixaP

<div class="container">

    <div class="topo">
        <h1> Controle de Caixa</h1>
        <p>Sistema de gerenciamento da papelaria</p>
    </div>

    <div class="conteudo">

        <!-- FORMULÁRIO -->
        <div class="card">
            <h2>Abertura / Fechamento de Caixa</h2>

            <div class="grupo-input">
                <label>Data de Abertura</label>
                <input type="date" />
            </div>

            <div class="grupo-input">
                <label>Data de Fechamento</label>
                <input type="date" />
            </div>

            <div class="grupo-input">
                <label>Valor Inicial (R$)</label>
                <input type="number" step="0.01" placeholder="0.00" />
            </div>

            <div class="grupo-input">
                <label>Valor Final (R$)</label>
                <input type="number" step="0.01" placeholder="0.00" />
            </div>

            <div class="grupo-input">
                <label>ID do Funcionário</label>
                <input type="number" placeholder="Digite o ID do funcionário" />
            </div>

            <div class="botoes">
                <button class="btn-salvar">Salvar</button>
                <button class="btn-limpar">Limpar</button>
            </div>
        </div>

        <!-- TABELA -->
        <div class="card">
            <h2>Histórico de Caixas</h2>

            <table>
                <thead>
                    <tr>
                        <th>Abertura</th>
                        <th>Fechamento</th>
                        <th>Inicial</th>
                        <th>Final</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cai in caixas)
                    {
                        <tr>
                            <td>@cai.DataAbertura.ToString("dd/MM/yyyy")</td>
                            <td>@cai.DataFechamento.ToString("dd/MM/yyyy")</td>
                            <td>@cai.ValorInicial.ToString("C")</td>
                            <td>@cai.ValorFinal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@code {
    private List<AppPapelaria1.Model.Caixa> caixas { get; set; } = new();
    private string? MensagemErro { get; set; }

    protected override Task OnInitializedAsync()
    {
        try
        {
            caixas = CaixaP.Listar();
        }
        catch (Exception ex)
        {
            MensagemErro = ex.Message;
        }

        return Task.CompletedTask;
    }
}