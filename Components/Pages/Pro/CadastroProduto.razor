@page "/produto/cadastro"

@rendermode InteractiveServer

@inject ProdutoDAO dao
@inject NavigationManager NavigationManager

@using AppPapelaria1.DAO
@using ProdutoModel = AppPapelaria1.Model.Produto

<PageTitle>Novo Produto - Sistema de Papelaria</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            Cadastro de Produto
        </h2>
    </div>
</div>

<div class="custom-table-card p-4">
    <EditForm Model="produto" OnValidSubmit="Salvar">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" />

        <!-- Nome do Produto -->
        <div class="row mb-3">
            <div class="col-md-12">
                <label for="nome" class="form-label">
                    Nome do Produto
                </label>

                <InputText id="nome"
                           class="form-control"
                           @bind-Value="produto.Nome" />

                <ValidationMessage For="@(() => produto.Nome)" />
            </div>
        </div>

        <!-- Preço e Categoria -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="preco" class="form-label">
                    Preço (R$)
                </label>

                <InputNumber id="preco"
                             class="form-control"
                             step="0.01"
                             @bind-Value="produto.Preco" />

                <ValidationMessage For="@(() => produto.Preco)" />
            </div>

            <div class="col-md-6">
                <label for="idCategoria" class="form-label">
                    Código da Categoria
                </label>

                <InputNumber id="idCategoria"
                             class="form-control"
                             @bind-Value="produto.IdCategoria" />

                <ValidationMessage For="@(() => produto.IdCategoria)" />
            </div>
        </div>

        <!-- Botões -->
        <div class="d-flex gap-2">
            <button type="submit"
                    class="btn btn-primary">
                <i class="bi bi-check-lg"></i>
                Salvar
            </button>

            <a href="/produto"
                   class="btn btn-light border">
                Cancelar
            </a>
        </div>

    </EditForm>
</div>

@code {
    private ProdutoModel produto = new();

    private void Salvar()
    {
        dao.Inserir(produto);

        NavigationManager.NavigateTo("/produto");
    }
}