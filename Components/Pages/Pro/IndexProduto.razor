@page "/IndexProduto"

@inject AppPapelaria1.Config.Conexao Conexao
@using AppPapelaria1.DAO
@using ProdutoModel = AppPapelaria1.Model.Produto

<div class="container">
    <div class="conteudo">
        <div class="card">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Cadastro e Consulta de Produtos</h2>
                </div>
            </div>

            <a href="/produtos/cadastro" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Novo Processo
            </a>
        </div>
    </div>


            <!-- Formulário de Cadastro -->
            <div class="mb-4">
                <h4 class="mb-3">Novo Produto</h4>
                
                <!-- Nome do Produto -->
                <div class="grupo-input mb-3">
                    <label>Nome do Produto</label>
                    <input type="text"
                           class="form-control"
                           @bind="produto.Nome"
                           placeholder="Digite o nome do produto" />
                </div>

                <!-- Preço -->
                <div class="grupo-input mb-3">
                    <label>Preço (R$)</label>
                    <input type="number"
                           step="0.01"
                           class="form-control"
                           @bind="produto.Preco"
                           placeholder="0,00" />
                </div>

                <!-- ID da Categoria -->
                <div class="grupo-input mb-3">
                    <label>Código da Categoria</label>
                    <input type="number"
                           class="form-control"
                           @bind="produto.IdCategoria"
                           placeholder="Digite o ID da categoria" />
                </div>

                <!-- Botões de Ação -->
                <div class="grupo-botoes mt-3">
                    <button class="btn btn-primary" @onclick="Cadastrar">Cadastrar</button>
                    <button class="btn btn-secondary ms-2" @onclick="Limpar">Cancelar</button>
                </div>

                <!-- Mensagem de Retorno -->
                @if (!string.IsNullOrEmpty(mensagem))
                {
                    <div class="mt-3 alert @(sucesso ? "alert-success" : "alert-danger")">
                        @mensagem
                    </div>
                }
            </div>

            <hr class="my-4" />

            <!-- Tabela de Consulta de Produtos -->
            <div>
                <h4 class="mb-3">Produtos Cadastrados</h4>
                @if (produtos == null || !produtos.Any())
                {
                    <p class="text-muted">Nenhum produto encontrado.</p>
                }
                else
                {
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>Preço</th>
                                <th>Categoria</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in produtos)
                            {
                                <tr>
                                    <td>@p.Id</td>
                                    <td>@p.Nome</td>
                                    <td>R$ @p.Preco.ToString("N2")</td>
                                    <td>@p.IdCategoria</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

        </div>
  
@code {
    private ProdutoModel produto = new();
    private List<ProdutoModel> produtos = new();
    private string mensagem = "";
    private bool sucesso = false;

    protected override void OnInitialized()
    {
        CarregarProdutos();
    }

    private void CarregarProdutos()
    {
        try
        {
            var dao = new ProdutoDAO(Conexao);
            produtos = dao.Listar();
        }
        catch
        {
            produtos = new List<ProdutoModel>();
        }
    }

    private void Cadastrar()
    {
        try
        {
            var dao = new ProdutoDAO(Conexao);
            dao.Inserir(produto);

            mensagem = "Produto cadastrado com sucesso!";
            sucesso = true;
            
            LimparFormulario();
            CarregarProdutos(); // Atualiza a tabela abaixo após o cadastro
        }
        catch (Exception ex)
        {
            mensagem = "Erro ao cadastrar produto: " + ex.Message;
            sucesso = false;
        }
    }

    private void LimparFormulario()
    {
        produto = new ProdutoModel();
    }

    private void Limpar()
    {
        LimparFormulario();
        mensagem = "";
    }
}