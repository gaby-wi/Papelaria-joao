@page "/caixa"
@using AppPapelaria1.DAO
@using AppPapelaria1.Model
@inject CaixaDAO caixaDAO

<PageTitle>Controle de Caixa</PageTitle>

<div class="container-fluid">
    <h1 class="h3 fw-bold text-gray-800 mb-4">Controle de Caixa</h1>

    <div class="custom-table-card p-4 mb-4">
        <EditForm Model="caixa" OnValidSubmit="Salvar">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" />

            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="dataAbertura" class="form-label">Data de Abertura</label>
                    <InputDate id="dataAbertura" class="form-control" @bind-Value="caixa.DataAbertura" />
                    <ValidationMessage For="() => caixa.DataAbertura" />
                </div>

                <div class="col-md-6">
                    <label for="dataFechamento" class="form-label">Data de Fechamento</label>
                    <InputDate id="dataFechamento" class="form-control" @bind-Value="caixa.DataFechamento" />
                    <ValidationMessage For="() => caixa.DataFechamento" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label for="valorInicial" class="form-label">Valor Inicial (R$)</label>

                    <InputNumber id="valorInicial" class="form-control" @bind-Value="caixa.ValorInicial" />
                    <ValidationMessage For="() => caixa.ValorInicial" />
                </div>

                <div class="col-md-4">
                    <label for="valorFinal" class="form-label">Valor Final (R$)</label>
                    <InputNumber id="valorFinal" class="form-control" @bind-Value="caixa.ValorFinal" />
                    <ValidationMessage For="() => caixa.ValorFinal" />
                </div>

                <div class="col-md-4">
                    <label for="idFuncionario" class="form-label">ID do Funcionário</label>
                    <InputNumber id="idFuncionario" class="form-control" @bind-Value="caixa.IdFuncionario" />
                    <ValidationMessage For="() => caixa.IdFuncionario" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Salvar
                </button>
            </div>
        </EditForm>
    </div>

    <!-- Tabela com Histórico de Caixas -->
    <div class="card shadow p-3">
        <h5 class="mb-3">Histórico de Caixas</h5>

        @if (caixas == null)
        {
            <p><em>Carregando dados...</em></p>
        }
        else if (caixas.Count == 0)
        {
            <p class="text-muted">Nenhum registro encontrado.</p>
        }
        else
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Abertura</th>
                        <th>Fechamento</th>
                        <th>Inicial</th>
                        <th>Final</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in caixas)
                    {
                        <tr>
                            <td>@c.Id</td>
                            <td>@(c.DataAbertura.HasValue ? c.DataAbertura.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td>@(c.DataFechamento.HasValue ? c.DataFechamento.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td>R$ @c.ValorInicial.ToString("F2")</td>
                            <td>@(c.ValorFinal.HasValue ? $"R$ {c.ValorFinal.Value:F2}" : "-")</td>
                            <td>
                                <span class="badge @(c.Status == "Aberto" ? "bg-success" : "bg-secondary")">
                                    @c.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private AppPapelaria1.Model.Caixa caixa = new();
    private List<AppPapelaria1.Model.Caixa> caixas = new();

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        caixas = caixaDAO.Listar();
    }

    private void Salvar()
    {
        caixaDAO.Inserir(caixa); //[cite: 13]
        caixa = new AppPapelaria1.Model.Caixa(); // Limpa o formulário
        CarregarDados(); // Atualiza a tabela abaixo na mesma tela
    }
}