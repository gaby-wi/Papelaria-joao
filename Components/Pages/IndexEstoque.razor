@page "/Processos"
@rendermode InteractiveServer
@inject EstoqueDAO dao;

<PageTitle> Processos - Sistema de Controled e Processos </PageTitle>

<div class="d-flex justify-content-between align-items-cent
er mb-4">
	<div>
		<h2 class="fw-bold mb-1">Consulta de Processos</h2>
	</div>
	<div>
		<a href="/processos/cadastro" class="btn btn-primary">
			<i class="bi bi-plus-lg"></i> Novo Processo
		</a>
	</div>
</div>

<div class="custom-table-card">
	<div>
		<table class=" table aling-middle">
			<thead>
				<tr>
					<th>Id</th>
					<th>QuantidadeInicial</th>
					<th>QuantidadeFinal</th>
					<th>IdProduto</th>
				</tr>
			</thead>

			<tbody>

				@foreach (var p in estoques)
				{
					<tr>
						<td>@p.Id</td>
						<td>@p.QuantidadeInicial</td>
						<td>@p.QuantidadeFinal	</td>
						<td>@p.IdProduto</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>

@code {
	private List<AppPapelaria1.Model.Estoque>? estoques;

	protected override void OnInitialized()
	{
		CarregarEstoque();
	}

	private void CarregarEstoque()
	{
		estoques = dao.Listar();
	}
}

