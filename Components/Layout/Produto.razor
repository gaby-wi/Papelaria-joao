@page "/produto"
@inject ProdutoDAO caixaDAO

<div class="container">

    <h1>Produto</h1>

    <div class="conteudo">

        <div class="card">


            <h2>Cadastro de Fornecedor</h2>

            <div class="grupo-input">
                <label>Nome da Empresa</label>

                <input type="text"
                       placeholder="Digite o nome da empresa" />
            </div>

            <div class="grupo-input">
                <label>CNPJ</label>

                <input type="text"
                       placeholder="00.000.000/0000-00" />
            </div>
        </div>
    </div>
</div>
