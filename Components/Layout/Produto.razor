@page "/produto"
@inject ProdutoDAO caixaDAO
@using AppPapelaria1.Model;
@using AppPapelaria1.DAO;

<div class="container">

    <h1>Produto</h1>

    <div class="conteudo">

        <div class="card">
            @* id_pro int auto_increment primary key,
            nome_pro varchar(150) not null,
            preco_pro float not null,
     
            id_cate_fk int not null,
            foreign key(id_cate_fk) references Categoria(id_cate)*@

            <h2>Produto</h2>

            <div class="grupo-input">
                <label>Id do produto</label>
                <input type="text"
                       placeholder="ex: 123456" />
            </div>

            <div class="grupo-input">
                <label>Nome do Produto</label>
                <input type="text"
                       placeholder="ex: caderno" />
            </div>

            <div class="grupo-input">
                <label>Preço do Produto</label>
                <input type="text"
					   placeholder="ex: 12.50" />
            </div>

            <div class="grupo-input">
                <label>Id da Categoria</label>
                <input type="text"
					   placeholder="ex: 1" />
            </div>
        </div>
    </div>
</div>
